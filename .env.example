# Copy to .env (or set in your shell) and replace placeholders.
# Do not commit .env — it is listed in .gitignore.

# --- Paths (override defaults if the repo root is not the working directory) ---
# INTUNE_DROP_INBOX_PATH=
# INTUNE_DROP_DONE_PATH=
# INTUNE_DROP_FAILED_PATH=
# INTUNE_DROP_STAGING_PATH=   # optional; if unset and repo path contains &, default staging is %LOCALAPPDATA%\IntuneDropPipeline\staging (IntuneWinAppUtil cannot use & in -c/-o paths)

# Full path to Microsoft Intune Win32 App Packaging Tool (IntuneWinAppUtil.exe)
INTUNE_DROP_PREP_TOOL_EXE=C:\\Tools\\IntuneWinAppUtil\\IntuneWinAppUtil.exe

# Entra ID group object ID to assign published Win32 apps (test ring)
INTUNE_DROP_TEST_GROUP_ID=00000000-0000-0000-0000-000000000000

# --- Entra app registration (application permissions + admin consent) ---
AZURE_TENANT_ID=11111111-1111-1111-1111-111111111111
AZURE_CLIENT_ID=22222222-2222-2222-2222-222222222222

# Graph auth: uncomment and set EXACTLY ONE credential block.

# Preferred — thumbprint after importing the app’s public+private key into Cert:\CurrentUser\My (or LocalMachine\My):
AZURE_CLIENT_CERTIFICATE_THUMBPRINT=0000000000000000000000000000000000000000

# Or — PFX file (comment out AZURE_CLIENT_CERTIFICATE_THUMBPRINT above when using this):
# AZURE_CLIENT_CERTIFICATE_PATH=C:\\secure\\apps\\intune-drop-pipeline.pfx
# AZURE_CLIENT_CERTIFICATE_PASSWORD=

# Legacy / lab only — Entra client secret (comment out certificate vars above; rotate often):
# AZURE_CLIENT_SECRET=your-client-secret-value

# Optional: path to a real .msi for Pester integration test (MsiMetadata.Tests.ps1)
# INTUNE_DROP_TEST_MSI_PATH=
